<!DOCTYPE html>
<html class="h-full">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>

    <title>Project</title>
</head>

<body class="h-full bg-gray-100 dark:bg-gray-900 transition-all">

<!-- Dark Mode Button -->
<button id="themeBtn"
    onclick="toggleDark()"
    class="absolute top-2 right-2 bg-black dark:bg-white text-white dark:text-black px-3 py-1 rounded transition">
    Dark Mode
</button>

<div class="min-h-screen flex">

    <!-- Sidebar -->
    <div class="w-64 bg-white dark:bg-gray-800 shadow-lg p-4">
    <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white">
        Projects
    </h2>

    <a href="/project/list"
       class="block p-2 hover:bg-gray-200 dark:hover:bg-gray-700 rounded text-gray-900 dark:text-white">
        ← All Projects
    </a>
</div>
    <!-- Main Area -->
    <div class="flex-1 p-6">

        <h1 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
            <%= project.title %>
        </h1>

        <!-- SAVE FORM -->
        <form method="POST" action="/project/save/<%=project._id%>">
            <textarea
                class="w-full h-96 p-4 bg-gray-900 text-green-400 font-mono rounded-lg"
                name="code"
            ><%= project.code %></textarea>

            <div class="mt-3">
                <button class="bg-blue-500 text-white px-4 py-2 rounded">
                    Save
                </button>
            </div>
        </form>

        <!-- AI BUTTONS -->
        <form method="POST" action="/project/ai/<%=project._id%>" class="mt-3">
            <input type="hidden" name="type" value="explain">
            <button class="bg-green-500 text-white px-4 py-2 rounded">
                Explain Code
            </button>
        </form>

        <form method="POST" action="/project/ai/<%=project._id%>" class="mt-2">
            <input type="hidden" name="type" value="fix">
            <button class="bg-red-500 text-white px-4 py-2 rounded">
                Fix Code
            </button>
        </form>

        <!-- AI OUTPUT -->
        <% if(typeof aiResponse !== 'undefined'){ %><div class="mt-5 p-4 bg-white dark:bg-gray-800 shadow rounded text-gray-900 dark:text-white"><h3 class="font-bold mb-2">🤖 AI Response</h3><pre class="whitespace-pre-wrap"><%= aiResponse %></pre></div><% } %>

    </div>
</div>

<!-- DARK MODE SCRIPT -->
<script>
function toggleDark(){
    const html=document.documentElement;
    const btn=document.getElementById("themeBtn");

    html.classList.toggle("dark");

    if(html.classList.contains("dark")){
        btn.innerText="Light Mode";
        btn.classList.remove("bg-black");
        btn.classList.add("bg-white","text-black");
    }else{
        btn.innerText="Dark Mode";
        btn.classList.remove("bg-white","text-black");
        btn.classList.add("bg-black","text-white");
    }
}
</script>
</body>
</html>