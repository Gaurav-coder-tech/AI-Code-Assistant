<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<button onclick="toggleTheme()" id="themeBtn"
style="position:fixed;top:12px;right:12px;width:40px;height:40px;border:none;border-radius:50%;cursor:pointer;font-size:18px;">
🌙
</button>

<div class="container">

    <h1>Your Projects</h1>

    <!-- CREATE PROJECT FORM -->
    <form action="/project/create" method="POST" style="margin-bottom:20px;">

        <input
            type="text"
            name="title"
            placeholder="Enter Project Title"
            required
            style="padding:10px;width:250px;"
        >

        <button
            type="submit"
            class="btn btn-blue">
            Create Project
        </button>

    </form>

    <!-- PROJECT LIST -->
    <% projects.forEach(p => { %>

        <div class="card">

            <h3><%= p.title %></h3>

            <a href="/project/<%= p._id %>">
                <button class="btn btn-blue">
                    Open
                </button>
            </a>
            <form
    action="/project/delete/<%= p._id %>"
    method="POST"
    style="display:inline;"
>

    <button
        class="btn btn-red"
        onclick="return confirm('Delete this project?')"
    >
        Delete
    </button>

</form>

        </div>

    <% }) %>

</div>

<script>

function setTheme(theme){
    document.body.className=theme;
    localStorage.setItem("theme",theme);
    updateIcon(theme);
}

function toggleTheme(){
    if(document.body.classList.contains("dark")){
        setTheme("light");
    }else{
        setTheme("dark");
    }
}

function updateIcon(theme){

    const btn=document.getElementById("themeBtn");

    if(theme==="dark"){

        btn.innerHTML=`
        <svg width="20" height="20" viewBox="0 0 24 24" fill="orange">
            <circle cx="12" cy="12" r="5"/>
        </svg>`;

    }else{

        btn.innerHTML=`
        <svg width="20" height="20" viewBox="0 0 24 24" fill="black">
            <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
        </svg>`;

    }
}

window.onload=function(){

    let saved=
    localStorage.getItem("theme")||"light";

    document.body.className=saved;

    updateIcon(saved);

}

</script>

</body>
</html>